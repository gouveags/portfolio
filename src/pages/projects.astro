---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { projects } from '../data/projects';
---
<Layout title="Projects" pageTitle="Projects" kind="page" description="Selected projects by Gabriel Gouvêa: Copa Ace, the Mutuals Twitch/OBS integration, and experimental Bend SDKs.">
  <div class="page-content">
    <header class="page-header">
      <p class="eyebrow">Selected work</p>
      <h1>Things I have worked on.</h1>
      <p class="lead">A few projects with the code or public product attached.</p>
    </header>
    <div class="entry-list project-list">
      {projects.map((project) => (
        <article class="entry">
          <span class="entry-mark" aria-hidden="true">{project.mark}</span>
          <div class="entry-main">
            <h2>{project.name}</h2>
            <p>{project.description}</p>
            <p class="entry-detail">{project.detail}</p>
            <div class="entry-links">{project.links.map((link) => <a class="text-link" href={link.href} target="_blank" rel="noopener noreferrer">{link.label}<Icon name="arrow-up-right" /></a>)}</div>
          </div>
        </article>
      ))}
    </div>
    <footer class="page-footer"><a class="text-link" href="/about/">More about my work <Icon name="arrow-right" /></a></footer>
  </div>
</Layout>
