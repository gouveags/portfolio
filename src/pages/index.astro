---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { apps } from '../data/navigation';
---
<Layout title="Home" pageTitle="Home" filename="welcome.md" kind="home" description="Gabriel Gouvêa. Software engineer building AI products, backend systems, and developer tools. Make yourself at home.">
  <div class="desktop-welcome">
    <div class="welcome-copy">
      <p class="eyebrow">Gabriel Gouvêa · Software engineer</p>
      <h1>Make yourself<br />at home.</h1>
      <p>This little desktop takes its shape from Omarchy<br class="wide-break" /> and my Fedora + Hyprland + Noctalia setup.</p>
      <p>They made me enjoy using Linux. I wanted to bring<br class="wide-break" /> a little of that feeling here: simple, useful, and<br class="wide-break" /> good to move around in.</p>
      <div class="welcome-actions"><a href="/open-source/" class="button">Explore open source <Icon name="arrow-right" /></a><a href="/blog/" class="text-link">Read the blog <Icon name="arrow-right" /></a></div>
    </div>
    <footer class="welcome-footer"><span>Click around. Every window is a real page.</span><a href="/guide/">? Guide</a></footer>
  </div>
  <div class="mobile-home">
    <div class="mobile-welcome"><p class="eyebrow">Gabriel Gouvêa</p><h1>Hey.<br />Welcome in.</h1><p>A few things I build, write,<br />and enjoy learning about.</p></div>
    <nav class="app-grid" aria-label="Apps">{apps.slice(1).map(app => <a href={app.path}><span class="app-icon"><Icon name={app.icon} /></span><span>{app.title}</span></a>)}</nav>
    <button class="home-search js-only" data-action="search"><Icon name="magnifying-glass" /><span>Find a page, project or note</span></button>
    <div class="mobile-home-credit"><a href="/credits/">Photo credits</a><span>·</span><button class="js-only" data-action="wallpaper-next">Wallpaper <Icon name="arrow-right" /></button><button class="js-only" data-action="wallpaper-pause" aria-label="Pause wallpaper motion" aria-pressed="false">Pause</button></div>
  </div>
</Layout>
