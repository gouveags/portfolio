---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
const experience = [
  { stage: 'Where it started', company: 'Icarus Formula SAE', role: 'Telemetry and data acquisition', detail: 'At Icarus, I worked on telemetry and data acquisition, connecting microcontrollers with desktop tools. It was a hands-on introduction to building software around a physical system and the people who needed to understand it.' },
  { stage: 'Building a product from zero', company: 'Realms · EduxGen.AI', role: 'Software engineering', detail: 'At Realms, I helped build EduxGen.AI from zero: an AI product for educational content. The work connected product decisions with backend systems, content generation, agent orchestration, and retrieval.' },
  { stage: 'What I’m working on now', company: 'MOVEdot', role: 'Software engineering', detail: 'Today I build AI products and the systems behind them at MOVEdot. My work spans agent infrastructure and product experiences, connecting what agents can do with how people actually use them.' },
];
---
<Layout title="Career" pageTitle="Career" kind="page" description="Gabriel Gouvêa’s path from race-car telemetry at Icarus to EduxGen.AI at Realms and AI products and agent infrastructure at MOVEdot.">
  <div class="page-content about-page">
    <header class="page-header">
      <p class="eyebrow">Career</p>
      <h1>Building products.<br />Understanding the systems behind them.</h1>
    </header>
    <div class="about-intro">
      <img class="about-portrait" src="/assets/me.png" alt="Gabriel Silva Gouvêa" width="240" height="240" loading="lazy" />
      <div class="about-copy">
        <p class="lead">I’m Gabriel, a software engineer currently at MOVEdot.</p>
        <p>My work has moved from race-car telemetry to building an AI product from zero, and now to agent infrastructure and product development. Across those settings, I like understanding the whole system and making it useful to the people working with it.</p>
        <p>Open source runs alongside that work. I contribute to tools I use, follow problems across project boundaries, and build a few experiments of my own.</p>
        <a class="button" href="/assets/CV_Gabriel_Silva_Gouvea_en-US.pdf" download>Download résumé <Icon name="arrow-down" /></a>
      </div>
    </div>
    <section class="timeline" aria-labelledby="experience-title" id="experience">
      <header class="section-header"><p class="eyebrow">Experience</p><h2 id="experience-title">The path so far</h2></header>
      {experience.map((item) => (
        <article class="timeline-entry">
          <p class="timeline-date">{item.stage}</p>
          <div><h3>{item.company}</h3><p class="timeline-company">{item.role}</p><p>{item.detail}</p></div>
        </article>
      ))}
    </section>
    <section aria-labelledby="open-source-title">
      <header class="section-header"><p class="eyebrow">Alongside my work</p><h2 id="open-source-title">Open source</h2></header>
      <p>AI observability in PostHog, reliability in the LangChain ecosystem, Linux desktop projects, and experiments with Bend. These are different ways of working on the tools I care about.</p>
      <a class="text-link" href="/open-source/">Explore my open-source work <Icon name="arrow-right" /></a>
    </section>
    <footer class="page-footer"><a class="text-link" href="/contact/">Get in touch <Icon name="arrow-right" /></a></footer>
  </div>
</Layout>
