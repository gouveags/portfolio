---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
const contributions = [
  { id: 'posthog', mark: 'PH', name: 'PostHog', description: 'LangChain v1 middleware for LLM analytics.', links: [{ label: 'PR #4556', href: 'https://github.com/PostHog/posthog-js/pull/4556', title: 'feat(ai): add LangChain v1 agent middleware' }] },
  { id: 'posthog-pricing', mark: 'PH', name: 'PostHog', description: 'Anthropic cache TTL costing and Bedrock inference profiles.', links: [{ label: 'PR #71323', href: 'https://github.com/PostHog/posthog/pull/71323', title: 'fix(aio): price Anthropic cache writes by TTL' }, { label: 'PR #74380', href: 'https://github.com/PostHog/posthog/pull/74380', title: 'fix(aio): match Bedrock pricing by inference profile' }] },
  { id: 'langchain', mark: 'LC', name: 'LangChain AWS', description: 'Correct credential precedence for AWS integrations.', links: [{ label: 'PR #1230', href: 'https://github.com/langchain-ai/langchain-aws/pull/1230', title: 'fix(aws): align ChatAnthropicMantle auth precedence with the Anthropic SDK Mantle client' }] },
];
const originals = [
  { id: 'bend', name: 'openai-bend', description: 'An experimental OpenAI SDK for Bend.', href: 'https://github.com/gouveags/openai-bend' },
  { id: 'anthropic-bend', name: 'anthropic-bend', description: 'An experimental Anthropic SDK for Bend.', href: 'https://github.com/gouveags/anthropic-bend' },
];
---
<Layout title="Open source" pageTitle="Open source" kind="page" description="Gabriel Gouvêa’s merged contributions to PostHog and LangChain AWS, and experimental open-source projects.">
  <div class="work-layout">
    <aside class="work-sidebar" aria-label="Open-source navigation">
      <p class="eyebrow">Work</p>
      <nav aria-label="Work pages">
        <a href="/open-source/" aria-current="page"><Icon name="code" />Open source</a>
        <a href="/projects/"><Icon name="folder" />Projects</a>
      </nav>
      <div class="sidebar-section">
        <p class="eyebrow">Explore</p>
        <nav aria-label="Contribution projects">
          <a href="/open-source/#posthog" data-filter-category="contributions">PostHog</a>
          <a href="/open-source/#langchain" data-filter-category="contributions">LangChain</a>
          <a href="/open-source/#bend" data-filter-category="original">Bend</a>
        </nav>
      </div>
    </aside>
    <div class="page-content">
    <header class="page-header">
      <p class="eyebrow">Small changes that add up</p>
      <h1>Building in the open.</h1>
      <p class="lead">Contributions to tools I use, and experiments I wanted to exist.<br class="desktop-only" /> Each one links to the code and the conversation behind it.</p>
    </header>
    <div class="tabs js-only" role="group" aria-label="Open-source work">
      <button type="button" data-filter-target="oss-list" data-filter-value="contributions" aria-pressed="true">Contributions</button>
      <button type="button" data-filter-target="oss-list" data-filter-value="original" aria-pressed="false">Original projects</button>
    </div>
    <div class="entry-list" id="oss-list">
      {contributions.map((item) => (
        <article class="entry" id={item.id} data-category="contributions">
          <span class="entry-mark" aria-hidden="true">{item.mark}</span>
          <div class="entry-main">
            <div class="entry-heading"><h2>{item.name}</h2><span class="tag">Merged</span></div>
            <p>{item.description}</p>
          </div>
          <div class="entry-meta entry-links">
            {item.links.map((link) => <a class="text-link" href={link.href} target="_blank" rel="noopener noreferrer" title={link.title} aria-label={`${link.label}: ${link.title} (opens in a new tab)`}>{link.label}<Icon name="arrow-up-right" /></a>)}
          </div>
        </article>
      ))}
      {originals.map((item) => (
        <article class="entry" id={item.id} data-category="original">
          <span class="entry-mark" aria-hidden="true">B</span>
          <div class="entry-main">
            <div class="entry-heading"><h2>{item.name}</h2><span class="tag">Experimental</span></div>
            <p>{item.description}</p>
          </div>
          <div class="entry-meta"><a class="text-link" href={item.href} target="_blank" rel="noopener noreferrer" aria-label={`View ${item.name} on GitHub (opens in a new tab)`}>View code <Icon name="arrow-up-right" /></a></div>
        </article>
      ))}
    </div>
    <footer class="page-footer"><a class="text-link" href="https://github.com/gouveags" target="_blank" rel="noopener noreferrer">View the full contribution history <Icon name="arrow-right" /></a></footer>
    </div>
  </div>
</Layout>
