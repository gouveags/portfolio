---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---
<Layout title="Contact" pageTitle="Contact" kind="page" description="Get in touch with Gabriel Gouvêa by email, GitHub, or LinkedIn.">
  <div class="page-content contact-page">
    <div class="contact-symbol" aria-hidden="true"><Icon name="envelope" /></div>
    <header class="page-header">
      <p class="eyebrow">Contact</p>
      <h1>Let’s talk.</h1>
      <p class="lead">You can find me around the web.</p>
    </header>
    <div class="contact-list">
      <a class="contact-link" href="mailto:gabrielgouvea@poli.ufrj.br"><Icon name="envelope" /><span>Email <small>gabrielgouvea@poli.ufrj.br</small></span><Icon name="arrow-up-right" /></a>
      <a class="contact-link" href="https://github.com/gouveags" target="_blank" rel="noopener noreferrer"><Icon name="code" /><span>GitHub</span><Icon name="arrow-up-right" /></a>
      <a class="contact-link" href="https://linkedin.com/in/gouveags" target="_blank" rel="noopener noreferrer"><Icon name="arrow-up-right" /><span>LinkedIn</span><Icon name="arrow-up-right" /></a>
    </div>
    <p class="contact-note">Have a question about a project?<br />The repository is a good place to start.</p>
    <footer class="page-footer"><span class="eyebrow">gouveags / contact</span></footer>
  </div>
</Layout>
