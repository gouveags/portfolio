---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
const contributions = [
  { id: 'posthog', mark: 'PH', name: 'PostHog', status: 'Contributions', description: 'Since July 2026, I’ve contributed to AI observability and cost accounting across PostHog: JavaScript and Python LangChain middleware, richer Gemini tool capture, and record/replay tests using real SDKs. Recent tool-result capture and Gemini Interactions work is still under review.', project: 'https://github.com/PostHog', history: 'https://github.com/pulls?q=is%3Apr+author%3Agouveags+org%3APostHog', links: [{ label: 'Middleware PR', href: 'https://github.com/PostHog/posthog-js/pull/4556', title: 'LangChain v1 agent middleware' }, { label: 'Cache pricing PR', href: 'https://github.com/PostHog/posthog/pull/71323', title: 'Anthropic cache writes by TTL' }, { label: 'Bedrock pricing PR', href: 'https://github.com/PostHog/posthog/pull/74380', title: 'Bedrock pricing by inference profile' }] },
  { id: 'langchain', mark: 'LC', name: 'LangChain and LangGraph', status: 'Contributions & proposal', description: 'My LangChain AWS contributions focus on credential selection and incomplete Bedrock streams. I’ve also proposed changes to LangGraph error handling; that proposal is not merged.', project: 'https://github.com/langchain-ai', history: 'https://github.com/pulls?q=is%3Apr+author%3Agouveags+org%3Alangchain-ai', links: [{ label: 'Credentials PR', href: 'https://github.com/langchain-ai/langchain-aws/pull/1230', title: 'AWS credential precedence' }] },
  { id: 'linux', mark: 'LX', name: 'Linux desktop', status: 'Participation', description: 'My Linux desktop is also a place to learn and contribute. I participate in the Noctalia, Terra, and Omarchy communities—the tools and setups that helped inspire this site.', project: 'https://github.com/noctalia-dev/noctalia-shell', history: 'https://github.com/gouveags', links: [{ label: 'Terra', href: 'https://github.com/terrapkg/packages', title: 'Terra packages' }, { label: 'Omarchy', href: 'https://github.com/basecamp/omarchy', title: 'Omarchy project' }] },
];
const originals = [
  { id: 'bend', name: 'openai-bend', description: 'An unofficial, experimental OpenAI SDK for Bend.', href: 'https://github.com/gouveags/openai-bend' },
  { id: 'anthropic-bend', name: 'anthropic-bend', description: 'An unofficial, experimental Anthropic SDK for Bend.', href: 'https://github.com/gouveags/anthropic-bend' },
  { id: 'bend-grammar', name: 'bend-grammar', description: 'TextMate syntax highlighting for Bend and Bend2, with tokenizer regression tests.', href: 'https://github.com/gouveags/bend-grammar' },
];
---
<Layout title="Open source" pageTitle="Open source" kind="page" description="Open-source work alongside Gabriel Gouvêa’s career: PostHog, LangChain, Linux desktop communities, and unofficial Bend SDK experiments.">
  <div class="work-layout">
    <aside class="work-sidebar" aria-label="Open-source navigation">
      <p class="eyebrow">Career</p>
      <nav aria-label="Career pages">
        <a href="/about/"><Icon name="info" />Career</a>
        <a href="/open-source/" aria-current="page"><Icon name="code" />Open source</a>
        <a href="/projects/"><Icon name="folder" />Projects</a>
      </nav>
      <div class="sidebar-section">
        <p class="eyebrow">Explore</p>
        <nav aria-label="Contribution projects">
          <a href="/open-source/#posthog" data-filter-category="contributions">PostHog</a>
          <a href="/open-source/#langchain" data-filter-category="contributions">LangChain</a>
          <a href="/open-source/#bend" data-filter-category="original">Bend</a>
        </nav>
      </div>
    </aside>
    <div class="page-content">
    <header class="page-header">
      <nav class="eyebrow" aria-label="Breadcrumb"><a href="/about/">Career</a> / <span aria-current="page">Open source</span></nav>
      <h1>Open source</h1>
      <p class="lead">A continuing part of my work: improving tools I use, learning with their communities, and making room for experiments.</p>
    </header>
    <div class="tabs js-only" role="group" aria-label="Open-source work">
      <button type="button" data-filter-target="oss-list" data-filter-value="contributions" aria-pressed="true">Contributions</button>
      <button type="button" data-filter-target="oss-list" data-filter-value="original" aria-pressed="false">Original projects</button>
    </div>
    <div class="entry-list" id="oss-list">
      {contributions.map((item) => (
        <article class="entry" id={item.id} data-category="contributions">
          <span class="entry-mark" aria-hidden="true">{item.mark}</span>
          <div class="entry-main">
            <div class="entry-heading"><h2>{item.name}</h2><span class="tag">{item.status}</span></div>
            <p id={item.id === 'posthog' ? 'posthog-pricing' : undefined}>{item.description}</p>
            <div class="entry-links"><a class="text-link" href={item.project}>Project <Icon name="arrow-up-right" /></a><a class="text-link" href={item.history}>Contribution history <Icon name="arrow-up-right" /></a></div>
          </div>
          <div class="entry-meta entry-links">
            {item.links.map((link) => <a class="text-link" href={link.href} target="_blank" rel="noopener noreferrer" title={link.title} aria-label={`${link.label}: ${link.title} (opens in a new tab)`}>{link.label}<Icon name="arrow-up-right" /></a>)}
          </div>
        </article>
      ))}
      {originals.map((item) => (
        <article class="entry" id={item.id} data-category="original">
          <span class="entry-mark" aria-hidden="true">B</span>
          <div class="entry-main">
            <div class="entry-heading"><h2>{item.name}</h2><span class="tag">Experimental</span></div>
            <p>{item.description}</p>
          </div>
          <div class="entry-meta"><a class="text-link" href={item.href} target="_blank" rel="noopener noreferrer" aria-label={`View ${item.name} on GitHub (opens in a new tab)`}>View code <Icon name="arrow-up-right" /></a></div>
        </article>
      ))}
    </div>
    <footer class="page-footer"><a class="text-link" href="https://github.com/gouveags" target="_blank" rel="noopener noreferrer">View the full contribution history <Icon name="arrow-right" /></a></footer>
    </div>
  </div>
</Layout>
